<UserControl x:Class="STStopwatch.Controls.CircularProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             SizeChanged="OnControlSizeChanged"
             MouseWheel="OnControlMouseWheel">
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <!-- Canvas for dynamic ring geometry -->
        <Canvas x:Name="RingCanvas" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Background solid white card for Super Minimized mode -->
            <Ellipse x:Name="SuperMiniBackgroundEllipse"
                     Fill="#FFFFFF"
                     Stroke="#111111"
                     StrokeThickness="1.5"
                     Visibility="Collapsed" />

            <!-- Edge Ambient Glow for Super Minimized mode -->
            <Ellipse x:Name="EdgeGlowEllipse"
                     Fill="Transparent"
                     Stroke="#0052FF"
                     StrokeThickness="2"
                     Opacity="0.6"
                     Visibility="Collapsed">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="EdgeGlowEffect" BlurRadius="14" ShadowDepth="0" Color="#0052FF" Opacity="0.85"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Background Full Track -->
            <Path x:Name="TrackPath"
                  Stroke="#E2E8F0"
                  StrokeThickness="10"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- Target Guide Arc (Setting mode on 16h dial) -->
            <Path x:Name="TargetGuidePath"
                  Stroke="#94A3B8"
                  StrokeThickness="2"
                  StrokeDashArray="2 3"
                  Opacity="0.5" />

            <!-- Completed Session Slices Canvas (Sessions of this Duration) -->
            <Canvas x:Name="CompletedSegmentsCanvas" Width="280" Height="280"/>

            <!-- Current Active Session Progress Arc -->
            <Path x:Name="ProgressArcPath"
                  Stroke="#0052FF"
                  StrokeThickness="10"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- Circular Target Adjustment & Progress Node -->
            <Grid x:Name="AdjustmentThumb"
                  Width="22" Height="22"
                  MouseDown="OnThumbMouseDown"
                  MouseMove="OnThumbMouseMove"
                  MouseUp="OnThumbMouseUp"
                  Canvas.Left="129" Canvas.Top="9">
                <!-- Outer Node Ring with crisp black border -->
                <Ellipse Fill="#FFFFFF"
                         Stroke="#111111"
                         StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Inner Color Core matching current session -->
                <Ellipse x:Name="ThumbInnerCore"
                         Width="10" Height="10"
                         Fill="#0052FF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Floating Target Tooltip / Badge during drag -->
            <Border x:Name="TargetBubble"
                    Canvas.Left="90" Canvas.Top="-28"
                    Background="#111111"
                    CornerRadius="10"
                    Padding="8,3"
                    Visibility="Collapsed">
                <TextBlock x:Name="TargetBubbleText"
                           Text="Target: 01h 00m"
                           Foreground="#FFFFFF"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"/>
            </Border>
        </Canvas>

        <!-- Center Content: Inside the circle -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- ST Emblem Logo Badge: Moves above the text in Super Minimized View -->
            <Border x:Name="SuperMiniLogoBadge"
                    Width="20" Height="20"
                    Background="#0052FF"
                    BorderBrush="#111111"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,3"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock Text="ST"
                           FontFamily="Georgia"
                           FontWeight="Bold"
                           FontStyle="Italic"
                           FontSize="10"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,1,0,0"/>
            </Border>

            <!-- Editable Session Label: Bold Italic Serif (Click to Edit) -->
            <TextBox x:Name="SessionLabelBox"
                     Text="{Binding SessionLabel, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Georgia"
                     FontWeight="Bold"
                     FontStyle="Italic"
                     FontSize="17"
                     Foreground="#475569"
                     Background="Transparent"
                     BorderThickness="0"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     MinWidth="150"
                     Cursor="IBeam"
                     ToolTip="Click to edit session name"
                     Margin="0,0,0,4">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="CaretBrush" Value="#0052FF"/>
                        <Setter Property="SelectionBrush" Value="#0052FF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="#111111"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                                <Setter Property="BorderBrush" Value="#0052FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Elapsed Time Display: Large Geometric Sans-Serif Tabular Numbers -->
            <TextBlock x:Name="ElapsedDisplay"
                       Text="00:00:00"
                       FontFamily="Segoe UI"
                       FontWeight="Bold"
                       FontSize="40"
                       Foreground="#111111"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False" />

            <!-- Target Finish Time Readout: Clock time when duration will end -->
            <StackPanel x:Name="FinishTimePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" IsHitTestVisible="False">
                <TextBlock x:Name="FinishLabel"
                           Text="target finish "
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#94A3B8"/>
                <TextBlock x:Name="FinishDisplay"
                           Text="{Binding TargetFinishTime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="#475569"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
