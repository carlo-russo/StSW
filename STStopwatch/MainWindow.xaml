<Window x:Class="STStopwatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:STStopwatch.Controls"
        xmlns:views="clr-namespace:STStopwatch.Views"
        Title="ST Stopwatch"
        Icon="Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        Width="380" Height="530"
        MinWidth="280" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">

    <!-- Window Shell Card with Crisp StartToday Border & Shadow -->
    <Border x:Name="WindowRootBorder"
            Background="#FFFFFF"
            BorderBrush="#111111"
            BorderThickness="1.5"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="MainContentGrid">
            <!-- Normal Stopwatch Mode Grid -->
            <Grid Visibility="{Binding IsStatisticsOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <!-- Header Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Stopwatch Circular Interface -->
                    <RowDefinition Height="*"/>
                    <!-- 3 Essential Playback Controls (Icons Only) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER BAR (Hidden in Minimal Mode) -->
                <Border Grid.Row="0"
                        Background="#F0F4F8"
                        BorderBrush="#111111"
                        BorderThickness="0,0,0,1"
                        Padding="12,8"
                        Visibility="{Binding IsMinimalMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Brand Logo & Title -->
                            <ColumnDefinition Width="*"/>
                            <!-- Window Control Actions -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ST Emblem Logo & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- ST Logo Emblem Badge -->
                            <Border Width="24" Height="24"
                                    Background="#0052FF"
                                    BorderBrush="#111111"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="0,0,8,0">
                                <TextBlock Text="ST"
                                           FontFamily="Georgia"
                                           FontWeight="Bold"
                                           FontStyle="Italic"
                                           FontSize="12"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1,0,0"/>
                            </Border>

                            <TextBlock Text="ST Stopwatch"
                                       FontFamily="Georgia"
                                       FontWeight="Bold"
                                       FontStyle="Italic"
                                       FontSize="15"
                                       Foreground="#111111"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Header Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Statistics Toggle Button -->
                            <Button Command="{Binding ToggleStatisticsCommand}"
                                    Style="{StaticResource HeaderToolButtonStyle}"
                                    Margin="0,0,4,0"
                                    ToolTip="View Statistics (Day &amp; Month)">
                                <TextBlock Text="📊" FontSize="11" Foreground="#111111"/>
                            </Button>

                            <!-- Always On Top Pin Toggle -->
                            <Button Command="{Binding ToggleAlwaysOnTopCommand}"
                                    Margin="0,0,4,0"
                                    ToolTip="Toggle Always On Top">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HeaderToolButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                                <Setter Property="Background" Value="#0052FF"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📌" FontSize="10" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>

                            <!-- Minimal Mode Toggle Button -->
                            <Button Command="{Binding ToggleMinimalModeCommand}"
                                    Style="{StaticResource HeaderToolButtonStyle}"
                                    Margin="0,0,4,0"
                                    ToolTip="Minimal Floating Mode">
                                <TextBlock Text="⤢" FontSize="12" FontWeight="Bold" Foreground="#111111"/>
                            </Button>

                            <!-- Minimize Window Button -->
                            <Button Click="OnMinimizeWindowClick"
                                    Style="{StaticResource HeaderToolButtonStyle}"
                                    Margin="0,0,4,0"
                                    ToolTip="Minimize">
                                <TextBlock Text="—" FontSize="10" FontWeight="Bold" Foreground="#111111"/>
                            </Button>

                            <!-- Close Window Button -->
                            <Button Command="{Binding CloseCommand}"
                                    Style="{StaticResource HeaderToolButtonStyle}"
                                    ToolTip="Close">
                                <TextBlock Text="✕" FontSize="10" Foreground="#111111"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MINIMAL MODE TOP FLOATING STRIP (Only visible in Minimal Mode) -->
                <Grid Grid.Row="0" Margin="10,6,10,0"
                      Visibility="{Binding IsMinimalMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ST Logo mini badge -->
                    <Border Width="20" Height="20"
                            Background="#0052FF"
                            BorderBrush="#111111"
                            BorderThickness="1"
                            CornerRadius="4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="ST"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   FontSize="10"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Restore Normal Mode Button -->
                        <Button Command="{Binding ToggleMinimalModeCommand}"
                                Style="{StaticResource HeaderToolButtonStyle}"
                                Width="22" Height="22" Margin="0,0,4,0"
                                ToolTip="Expand to Normal Mode">
                            <TextBlock Text="⤡" FontSize="11" FontWeight="Bold" Foreground="#111111"/>
                        </Button>

                        <!-- Close Button -->
                        <Button Command="{Binding CloseCommand}"
                                Style="{StaticResource HeaderToolButtonStyle}"
                                Width="22" Height="22"
                                ToolTip="Close">
                            <TextBlock Text="✕" FontSize="9" Foreground="#111111"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- STOPWATCH CIRCULAR INTERFACE (Row 1) -->
                <Grid Grid.Row="1" Margin="16,10,16,6">
                    <Grid.RowDefinitions>
                        <!-- Session Indicator Pill (Only Session Number 01-12) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Main Circular Progress Ring with Adjustable Target Node -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Current Session Number Display (01 to 12 as the only additional session information) -->
                    <Border Grid.Row="0"
                            Background="#F0F4F8"
                            BorderBrush="#111111"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Colored dot matching current session -->
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding CurrentSessionColor}"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="SESSION "
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>
                            <TextBlock Text="{Binding CurrentSessionPillText}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#111111"/>
                        </StackPanel>
                    </Border>

                    <!-- Large Circular Progress Ring with Editable Session Label, Slices, and Target Finish Time -->
                    <controls:CircularProgressRing Grid.Row="1"
                                                   Progress="{Binding Progress}"
                                                   Elapsed="{Binding Elapsed}"
                                                   TotalElapsed="{Binding TotalElapsed}"
                                                   TargetDuration="{Binding TargetDuration, Mode=TwoWay}"
                                                   TargetFinishTime="{Binding TargetFinishTimeText}"
                                                   SessionLabel="{Binding SessionLabelText, Mode=TwoWay}"
                                                   RingBrush="{Binding CurrentSessionColor}"
                                                   CompletedSegments="{Binding CompletedSegments}"
                                                   IsRunning="{Binding IsRunning}"
                                                   IsMinimalMode="{Binding IsMinimalMode}"/>
                </Grid>

                <!-- 3 CONTROLS (Row 2): Start/Pause on Left, Completed/End in Middle, Next on Right -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        BorderBrush="#111111"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- 1. Start / Pause / Resume (Left) -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <!-- 2. Completed / End (Middle) -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <!-- 3. Next Session (Right) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. Start / Pause / Resume Button (Left) -->
                        <Button Grid.Column="0"
                                Command="{Binding PlayPauseCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Width="68" Height="46"
                                ToolTip="{Binding PlayPauseButtonLabel}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Play Triangle Icon (Visible when stopped / paused) -->
                                <Path Data="M 0 0 L 14 8 L 0 16 Z"
                                      Fill="#FFFFFF"
                                      Width="14" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="3,0,0,0"
                                      Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <!-- Pause Two Bars Icon (Visible when running) -->
                                <Grid Width="13" Height="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4.5"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="4.5"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#FFFFFF" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Column="2" Fill="#FFFFFF" RadiusX="1" RadiusY="1"/>
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- 2. Completed / End Button (Middle) -->
                        <Button Grid.Column="2"
                                Command="{Binding CompleteSessionCommand}"
                                Style="{StaticResource OutlineActionButtonStyle}"
                                Width="88" Height="46"
                                ToolTip="Complete / End Session Block">
                            <Path Data="M 3 8.5 L 7 12.5 L 16 3.5"
                                  Stroke="#111111"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="15"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>

                        <!-- 3. Next Session Button (Right) -->
                        <Button Grid.Column="4"
                                Command="{Binding NextSessionCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Width="68" Height="46"
                                ToolTip="Next Session (Continues automatically)">
                            <Grid Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="3"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M 0 0 L 10 7.5 L 0 15 Z" Fill="#111111" Stretch="Fill"/>
                                <Rectangle Grid.Column="2" Fill="#111111" RadiusX="1" RadiusY="1"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Dedicated Statistics Section (Day View & Month View) -->
            <views:StatisticsView Visibility="{Binding IsStatisticsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Border>
</Window>
