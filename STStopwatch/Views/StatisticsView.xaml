<UserControl x:Class="STStopwatch.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:STStopwatch.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">
    <Grid Background="#F7FAFE">
        <Grid.RowDefinitions>
            <!-- Header with Title & Back Button -->
            <RowDefinition Height="Auto"/>
            <!-- Segmented Tab Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Content View -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#F7FAFE" BorderBrush="#C7D5E6" BorderThickness="0,0,0,0.75" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Performance &amp; Statistics"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"

                               FontSize="18"
                               Foreground="#111111"/>
                </StackPanel>

                <!-- Return to TimerQt button -->
                <Button Grid.Column="1"
                        Command="{Binding ToggleStatisticsCommand}"
                        Style="{StaticResource SmallPillButtonStyle}"
                        Padding="10,4"
                        ToolTip="Return to TimerQt">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕ Close" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#111111"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Segmented Tab Bar: Day View | Month View -->
        <Border Grid.Row="1" Background="#EDF4FC" BorderBrush="#C7D5E6" BorderThickness="1" CornerRadius="12" Margin="12,8,12,5" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Day View Tab Button -->
                <RadioButton Grid.Column="0"
                             GroupName="StatsViews"
                             Content="Day View"
                             IsChecked="{Binding StatisticsVM.IsDayView, Mode=OneWay}"
                             Click="OnDayViewTabClicked"
                             Style="{StaticResource SegmentedTabRadioStyle}"/>

                <!-- Month View Tab Button -->
                <RadioButton Grid.Column="1"
                             GroupName="StatsViews"
                             Content="Month View"
                             IsChecked="{Binding StatisticsVM.IsMonthView, Mode=OneWay}"
                             Click="OnMonthViewTabClicked"
                             Style="{StaticResource SegmentedTabRadioStyle}"/>
            </Grid>
        </Border>

        <!-- View Switcher -->
        <Grid Grid.Row="2" DataContext="{Binding StatisticsVM}">
            <!-- Day View Control -->
            <views:DayViewControl Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Month View Control -->
            <views:MonthViewControl Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
